# Optional per-run overrides for start.sh.
#
# To use this file:  cp .env.sample .env   (the real .env is not tracked
# by git — this sample is what gets committed). Every variable below is
# optional; unset/removed values fall back to start.sh's own defaults.
#
# Precedence (highest first):
#   1. shell env vars already exported when you run ./start.sh
#   2. values in ./.env
#   3. start.sh inline defaults
#
# Default (shown below): native 262K context, YaRN off, 10 concurrent
# requests. To go above 262144 (e.g. 512K or 1M), set YARN=1 and the
# desired CONTEXT_LENGTH as explained below.

# Model checkpoint: nvfp4 (default) | fp8 | bf16
QUANT=nvfp4

# YaRN rope scaling — REQUIRED for any context above the native 262144:
#   0 = off (the default; only valid with CONTEXT_LENGTH <= 262144)
#   1 = on  (use for e.g. 500K / 786K / 1M)
# Note: YARN implicitly turns on at exactly 1000000 even if set to 0.
# The scaling factor is derived for you:
#   factor = round(CONTEXT_LENGTH / 262144)  (must be >= 1)
#   e.g. 524288 -> 2.0, 786432 -> 3.0, 1000000 -> 4.0
#   (2.0 and 4.0 are the model card's validated values; in-between
#    factors work too but are outside the card's tested points).
# WARNING: YaRN is NOT compatible with the DSpark speculative-draft
# alternative on this SGLang build — keep YARN=0 / CONTEXT_LENGTH=262144
# if you ever switch --speculative-algorithm to DSPARK.
YARN=0

# Context length in tokens (range 262144..1000000):
#   262144  = model native (default; no rope scaling needed)
#   524288  = 512K  (needs YARN=1)
#   786432  = 768K  (needs YARN=1)
#   1000000 = 1M   (needs YARN=1; also auto-on)
CONTEXT_LENGTH=262144

# Max concurrent requests (default 10). start.sh sizes the GDN state
# pool from this value automatically:
#   --max-mamba-cache-size  = MAX_CONCURRENT_REQUESTS x 8 slots  (MTP)
#   --max-running-requests  = MAX_CONCURRENT_REQUESTS
# Memory note: 1 KV token ~= 32.8 KB; a full 1M-token request needs
# ~33 GB. The pool fits ~2 full-length 1M sequences, so the 3rd
# concurrent 1M request is admitted as KV frees.
MAX_CONCURRENT_REQUESTS=10
